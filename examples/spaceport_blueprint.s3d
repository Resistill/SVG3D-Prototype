// 航天基地 · 蓝图风格
// 风格就是一个只改外观的层：重新定义材质，把某些语义的外观换成变体。
// 外包络不变，所以空间事实、概念识别与基础描述完全相同。
import "spaceport.s3d"

material ground   color=#14365e rough=1
material asphalt  color=#1d4a7d rough=1
material earth    color=#2a5c94 rough=1
material concrete color=#e8f1fb rough=0.9
material steel    color=#9fc4ea metal=0.1 rough=0.6
material white    color=#ffffff rough=0.8
material hazard   color=#f3c969 rough=0.8

// 屋顶换成肋板：模板收到外包络的尺寸 w h d，在里面铺满
def ribbed(w=1, h=1, d=1) {
  box base size=w,h*0.35,d
  repeat rib n=floor(w/1.6) step=w/floor(w/1.6),0,0 center=true on=base { box r size=0.3,h*0.65,d }
}
over hangar.roof use=ribbed
over wings.annex color=#cfe3f7
