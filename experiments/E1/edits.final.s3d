// 修改层：over / drop / copy / 新物体 / def 扩展。重跑逆向后这里的路径仍然有效（稳定命名）
// 提议 001：源火箭是下段r2.4至y29.2、上段r2.0、顶部椭球鼻锥（front id 渲染逐行测宽得出），单一圆柱r2.4误差0.43m
drop tank_2
revolve rocket profile=[(2.4,0);(2.4,27.2);(2,27.2);(2,42.5);(1.9,44.5);(1.6,46.5);(1.1,48);(0.6,48.7);(0,49)] on=platform_1 mat=white
over slab_1 at=rocket offset=0,2.7,0
over slab_2 at=rocket offset=-3.35,11.49,-3.35
// 提议 003：源储罐是r3.5圆柱+半球顶（front id 逐行测宽与半球轮廓吻合）；整体替换阵列以换形状
drop tanks
// 提议 004：储罐 revolve 后仍 maxErr=2、meanErr≈0.13：推测源网格是圆柱+整球（球的下半在圆柱内部），改写为 cyl h9 + sphere r3.5，描述也更短
repeat tank_row n=3 step=10,0,0 on=terrain[0.2,1,0.55] pin=origin {
  cyl tank r=3.5 h=9 mat=white
  sphere dome r=3.5 at=tank.top offset=0,-3.5,0 mat=white
  cyl slab r=3.6 h=0.6 at=tank offset=0,1.5,0 mat=hazard
}
// 提议 005：volume_4 源部件是螺旋楼梯的扶手（source 聚焦图），被拟合成楔形；改为沿螺旋线扫掠的圆管，半径/高度取自原包络与台阶阵列(每圈6.24m)
drop volume_4
helix rail_path r=2.1 pitch=6.24 turns=1 at=column_1.bottom+(0,1,0)
// 提议 006：beam_2 的源部件是从发射台南沿(z≈13)到 1 号罐北侧(z≈51.5)的直管（top/right id 渲染测得中心线，高度沿原包络 y1~2.75 线性下降），楔形拟合误差 0.17m
drop beam_2
// 提议 007：两根输送管在平面上都是两端沿 z 向的 S 形（top id 渲染中心线拟合三次贝塞尔，rms 4~7cm），高度两端平、中间过渡；直管 feed_1 改贝塞尔，beam_1 楔形换成同样的贝塞尔管
drop beam_1
// 提议 008：right 视角 id 聚焦对照：源管截面厚 36 行、重建 30 行，高度剖面一致 → 管半径应为 0.35（中心高度相应改为 1.35~2.4）；坐标顺便取一位小数
bezier feed_1_path path=[(21.1,2.4,13.1);(21.1,2.4,25);(20,1.35,31.5);(20,1.35,51.5)]
sweep feed_1 path=feed_1_path profile=circle r=0.35 mat=steel
bezier feed_2_path path=[(29.1,2.4,13.1);(29.1,2.4,27);(40,1.35,29.5);(40,1.35,51.5)]
sweep feed_2 path=feed_2_path profile=circle r=0.35 mat=steel
// 提议 013：改用整数尺寸 12×8×14：34+2×12=58 恰为原包络宽、14 与测得 13.8 吻合、8 与台阶顶 y=8 吻合；10/8/7.6 的试验表明分数在真值附近很陡
over volume_1 size=34,22,26
box annex size=12,8,14 against=volume_1.left align=bottom,back mat=concrete
mirror annex_2 of=annex across=volume_1 axis=x
// 提议 014：front 视角 id 聚焦对照：扶手中心线（左右极值列）与源吻合，但斜段截面宽度重建比源大约 18% → 管半径 0.06 改 0.05
sweep rail path=rail_path profile=circle r=0.05 mat=steel
// 提议 016：塔架 16 根斜撑各有 2.7mm 系统误差（rot 轴取整 (0.35,0.937) 致 0.05° 偏角）；由包络反推端点恰为立柱中心 (37.1,2.4)→(31.1,7.6)，改用 span 精确连两点，阵列+镜像保持结构
drop slabs_1.*.member
repeat braces n=8 step=0,6,0 {
  span brace from=(37.1,2.4,-6.1) to=(31.1,7.6,-6.1) r=0.15 mat=steel
}
mirror braces_2 of=braces across=platform_1 axis=x
// 提议 018：四组台阶每级都有恰好 5mm 的 maxErr：offset 取整所致——props_1 前沿应与主厅正面 z=-7 平齐(12.63→12.625)，props_3 外沿应与附楼外墙 x=-74 平齐(-28.72→-28.723)；镜像组随之修正
over props_1 at=volume_1 offset=23,-10.75,12.625
// 提议 019：props_3/4 的 maxErr 随 x 偏移线性变化：-28.72→5.1mm、-28.723→2.1mm，外推 -28.725 处为 0（首级中心 x=-73.725）
over props_3 at=volume_1 offset=-28.725,-2.46,-6
