// layer=edits why=column_2 其实是火箭：两级圆柱（r=2.4 h=28、r=2 h=14）+ 整流罩旋转体（轮廓按正交前视图量出）；一条外轮廓 revolve 把级间台阶画成了斜坡，也解释不了级间的端面
drop column_2
group rocket on=platform_1 mat=white {
  cyl stage1 r=2.4 h=28
  cyl stage2 r=2 h=14 on=stage1
  revolve nose profile=[(2,0); (1.9,2.5); (1.45,5); (0.7,6.6); (0,7)] smooth=true on=stage2
}
